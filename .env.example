# development | test | production
APP_ENV=development

# Local development: file:./local.db
# Turso: libsql://database-name-organization.turso.io
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated browser origins allowed to use authentication endpoints.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Maximum XLSX upload size (4 MiB default; allowed range 1 KiB–4 MiB)
IMPORT_MAX_FILE_BYTES=4194304
